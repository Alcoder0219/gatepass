# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# NEVER put real credentials in this file — it is committed to git.
# Put the real URI in `.env` (gitignored). Local: mongodb://127.0.0.1:27017/gatepass
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gatepass?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# ─── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Mail (Nodemailer) ─────────────────────────────────────────────────────
# Leave SMTP_HOST empty to log emails to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GatePass Pro <no-reply@gatepasspro.io>"

# ─── Gmail API (service account + domain-wide delegation) ──────────────────
# Optional. Leave GMAIL_ENABLED=false and the Gmail transport stays dormant —
# the existing SMTP/console transport is unaffected either way.
#
# NEVER put a real key in this file — it is committed to git.
#
# Credentials resolve from ONE of two sources, env vars first:
#
#   1. Cloud Run  — set GMAIL_SERVICE_ACCOUNT_EMAIL and
#      GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY via Variables & Secrets. No file on
#      disk. Escaped \n in the key is normalised automatically.
#
#   2. Local dev  — leave those two blank and point
#      GMAIL_SERVICE_ACCOUNT_KEY_PATH at the downloaded service-account JSON,
#      e.g. ./secrets/service-account.json. That directory is gitignored.
#      The file is read lazily, only when the first email is sent.
#
# The env vars take precedence, so a deployed configuration can never be
# overridden by a stray local key file.
GMAIL_ENABLED=false
GMAIL_SERVICE_ACCOUNT_EMAIL=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=
GMAIL_SERVICE_ACCOUNT_KEY_PATH=
# The Workspace user the service account impersonates — this is the account all
# automated GatePass and Leave mail is sent AS. Changing the sender means
# changing this value (and GMAIL_FROM below) and nothing else.
GMAIL_IMPERSONATE_USER=alert@amsonsgroup.net
GMAIL_PROJECT_ID=
# Sender for Gmail only. Falls back to MAIL_FROM when unset; setting this
# separately leaves the existing SMTP transport's sender untouched.
# The address here MUST match GMAIL_IMPERSONATE_USER (or be a verified alias of
# it) — Gmail rewrites or rejects a From it has not authorised. Only the display
# name is free text.
GMAIL_FROM="Amsons Group <alert@amsonsgroup.net>"

# Mounts the /email-test diagnostics routes even when NODE_ENV=production.
# Leave unset. Admin-only regardless, but there is no reason to expose it.
EMAIL_TEST_ROUTE_ENABLED=false

# ─── Security ──────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# ─── Seed ──────────────────────────────────────────────────────────────────
# Only used by the DEMO seeder (`npm run seed`). Never run that in production —
# it creates 20 accounts that all share this password. Use `npm run seed:prod`.
SEED_DEFAULT_PASSWORD=Passw0rd@123

# ─── Production bootstrap (`npm run seed:prod`) ────────────────────────────
# The single super admin created on a fresh production database.
SUPERADMIN_NAME=Bhanu Partap
SUPERADMIN_EMAIL=bhanupartap@amsongroup.com
SUPERADMIN_PASSWORD=
SUPERADMIN_EMPLOYEE_ID=EMP0001SA

# Set to false on every API replica but one (the expiry sweep is in-process).
JOBS_ENABLED=true
